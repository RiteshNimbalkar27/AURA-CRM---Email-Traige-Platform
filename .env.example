# ============================================================
# AURA Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to source control
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+psycopg://aura:aura_dev_password@localhost:5432/aura_db
POSTGRES_DB=aura_db
POSTGRES_USER=aura
POSTGRES_PASSWORD=aura_dev_password

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT Auth ---
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_use_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Gemini API (SYNTHETIC DATA ONLY) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- Local Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Cache stored inside project directory (not on C: drive)
EMBEDDING_CACHE_DIR=./data/model_cache

# --- Web Enrichment (ALLOWLISTED URLS ONLY) ---
ENRICHMENT_REVIEW_URL=https://www.g2.com/products/nexus-software
ENRICHMENT_COMPETITOR_URL=https://competitor.example.com/pricing

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# CRITICAL: Must be true. Prevents real PII from reaching Gemini.
SYNTHETIC_DATA_ONLY=true
